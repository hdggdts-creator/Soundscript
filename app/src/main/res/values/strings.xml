    <string name="settings_privacy_b1_title">Local SQLite &amp; Cloud Firestore Dual Persistence</string>
    <string name="settings_privacy_b1_desc">All notes are cached on device via Room and backed up in real time to your private Cloud Firestore collection.</string>
    <string name="settings_privacy_b2_title">No Raw Speech Transcript Exposure</string>
    <string name="settings_privacy_b2_desc">Raw lecture transcripts are never surfaced or stored as user-facing outputs; the AI model directly synthesizes clean, structured medical study notes.</string>
    <string name="settings_privacy_b3_title">Direct Secure Gemini REST Pipeline</string>
    <string name="settings_privacy_b3_desc">Audio and text prompts are encrypted in transit (TLS 1.3) directly to Google\'s official Gemini endpoint using your project\'s configured API key.</string>
    <string name="settings_privacy_b4_title">Searchable Offline PDF Export</string>
    <string name="settings_privacy_b4_desc">Exported PDFs are compiled natively on device using Android\'s native Graphics PDF engine and saved in your device\'s private app cache.</string>
